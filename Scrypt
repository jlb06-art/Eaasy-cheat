        listScroll.Size = UDim2.new(1, -12, 0, 120)
        listScroll.Position = UDim2.new(0, 6, 0, 38)
        listScroll.BackgroundColor3 = Color3.fromRGB(22, 26, 34)
        listScroll.BorderSizePixel = 0
        listScroll.ScrollBarThickness = 4
        listScroll.ScrollBarImageColor3 = Color3.fromRGB(0, 165, 255)
        listScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        listScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        listScroll.Parent = container
        Instance.new("UICorner", listScroll).CornerRadius = UDim.new(0, 4)

        local listLayout = Instance.new("UIListLayout")
        listLayout.Padding = UDim.new(0, 3)
        listLayout.Parent = listScroll

        local listPad = Instance.new("UIPadding")
        listPad.PaddingTop = UDim.new(0, 4)
        listPad.PaddingBottom = UDim.new(0, 4)
        listPad.PaddingLeft = UDim.new(0, 4)
        listPad.PaddingRight = UDim.new(0, 4)
        listPad.Parent = listScroll

        local function setOpenState(open)
            isOpen = open
            local itemCount = math.min(#options, 4)
            local listHeight = isOpen and math.max(itemCount * 28 + 10, 38) or 0
            local targetHeight = isOpen and (38 + listHeight + 6) or 34
            listScroll.Size = UDim2.new(1, -12, 0, listHeight)
            TweenService:Create(container, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, targetHeight)
            }):Play()
            TweenService:Create(arrow, TweenInfo.new(0.2), {
                Rotation = isOpen and 180 or 0
            }):Play()
        end

        local function rebuildItems()
            for _, child in pairs(listScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            if #options == 0 then
                local emptyBtn = Instance.new("TextButton")
                emptyBtn.Size = UDim2.new(1, 0, 0, 26)
                emptyBtn.BackgroundColor3 = Color3.fromRGB(32, 37, 48)
                emptyBtn.Text = "Aucun élément disponible"
                emptyBtn.TextColor3 = Color3.fromRGB(150, 155, 165)
                emptyBtn.Font = Enum.Font.Gotham
                emptyBtn.TextSize = 11
                emptyBtn.Parent = listScroll
                Instance.new("UICorner", emptyBtn).CornerRadius = UDim.new(0, 4)
                return
            end
            for _, item in ipairs(options) do
                local itemBtn = Instance.new("TextButton")
                itemBtn.Size = UDim2.new(1, 0, 0, 26)
                itemBtn.BackgroundColor3 = (item == current) and Color3.fromRGB(0, 125, 210) or Color3.fromRGB(32, 37, 48)
                itemBtn.Text = tostring(item)
                itemBtn.TextColor3 = Color3.fromRGB(240, 245, 255)
                itemBtn.Font = Enum.Font.GothamSemibold
                itemBtn.TextSize = 11
                itemBtn.Parent = listScroll
                Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)

                itemBtn.MouseButton1Click:Connect(function()
                    current = item
                    titleText.Text = string.format("%s : %s", tostring(opts.Name), tostring(current))
                    rebuildItems()
                    setOpenState(false)
                    if opts.Callback then opts.Callback(current) end
                end)
            end
        end

        rebuildItems()

        headerBtn.MouseButton1Click:Connect(function()
            setOpenState(not isOpen)
        end)

        return {
            Refresh = function(_, newList)
                options = newList or {}
                if #options > 0 and not table.find(options, current) then
                    current = options[1]
                    if opts.Callback then opts.Callback(current) end
                elseif #options == 0 then
                    current = "Aucun"
                end
                titleText.Text = string.format("%s : %s", tostring(opts.Name), tostring(current))
                rebuildItems()
                if isOpen then setOpenState(true) end
            end
        }
    end

    return api
end

