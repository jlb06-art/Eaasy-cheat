            Camera.CameraType = Enum.CameraType.Scriptable
            freecamConn = RunService.RenderStepped:Connect(function(dt)
                local delta = UserInputService:GetMouseDelta()
                if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                    freecamRot = freecamRot - Vector2.new(delta.Y * 0.005, delta.X * 0.005)
                end
                local rotCFrame = CFrame.fromEulerAnglesYXZ(freecamRot.X, freecamRot.Y, 0)
                local dir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Z) then dir = dir + rotCFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - rotCFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then dir = dir - rotCFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + rotCFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
                if dir.Magnitude > 0 then dir = dir.Unit end
                freecamPos = freecamPos + (dir * flySpeed * dt)
                Camera.CFrame = CFrame.new(freecamPos) * rotCFrame
            end)
        else
            if freecamConn then freecamConn:Disconnect() freecamConn = nil end
