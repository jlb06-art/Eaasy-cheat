RunService.RenderStepped:Connect(function()
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    if fovCircle then
        pcall(function()
            fovCircle.Position = UserInputService:GetMouseLocation()
            fovCircle.Radius = aimFOV
            fovCircle.Visible = showFOVCircle
            if rainbowFOV then
                fovCircle.Color = Color3.fromHSV((tick() % 5) / 5, 1, 1)
            else
                fovCircle.Color = Color3.fromRGB(255, 255, 255)
            end
        end)
    end

    if not aimbotEnabled then return end
    if aimHoldRightClick and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        return
    end

    local closest = nil
    local maxDist = aimFOV
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(targetPart) then
            if teamCheck and p.Team ~= nil and LocalPlayer.Team ~= nil and p.Team == LocalPlayer.Team then continue end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local partObj = p.Character[targetPart]
                local pos, onScreen = Camera:WorldToViewportPoint(partObj.Position)
                if onScreen and isVisible(partObj) then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < maxDist then
                        maxDist = dist
                        closest = p
                    end
                end
            end
        end
    end

    if closest and closest.Character and closest.Character:FindFirstChild(targetPart) then
        local targetPartObj = closest.Character[targetPart]
        local targetPos = targetPartObj.Position
        local hrp = closest.Character:FindFirstChild("HumanoidRootPart")
        if hrp then targetPos = targetPos + (hrp.AssemblyLinearVelocity * predictionFactor) end
        local goalCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, 1 / aimSmoothing)
    end
end)

