                    if onScreen then
                        local col = (espTeamColor and p.TeamColor) and p.TeamColor.Color or Color3.fromRGB(255, 50, 50)
                        if tracersActive then
                            d.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            d.Line.To = Vector2.new(pos.X, pos.Y)
                            d.Line.Color = col
                            d.Line.Visible = true
                        else
                            d.Line.Visible = false
                        end

                        if boxes2DActive then
                            local scale = 1000 / math.max(pos.Z, 0.1)
                            d.Box.Size = Vector2.new(scale * 2.2, scale * 3.2)
                            d.Box.Position = Vector2.new(pos.X - d.Box.Size.X / 2, pos.Y - d.Box.Size.Y / 2)
                            d.Box.Color = col
                            d.Box.Visible = true
                        else
                            d.Box.Visible = false
                        end
                    else
                        d.Line.Visible = false
                        d.Box.Visible = false
                    end
                else
                    d.Line.Visible = false
                    d.Box.Visible = false
                end
            end
        end
    end
end)

