local chamsActive = false
local espTeamColor = true
local espNamesActive = false
local tracersActive = false
local boxes2DActive = false

local function updateESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local existing = p.Character:FindFirstChild("ESP_Highlight")
            if chamsActive then
                if not existing then
                    local hl = Instance.new("Highlight")
                    hl.Name = "ESP_Highlight"
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.4
                    hl.Parent = p.Character
                    existing = hl
                end
                if espTeamColor and p.TeamColor then
                    existing.FillColor = p.TeamColor.Color
                else
                    existing.FillColor = Color3.fromRGB(255, 20, 20)
                end
            elseif existing then
                existing:Destroy()
            end

            local head = p.Character:FindFirstChild("Head")
            local existingTag = head and head:FindFirstChild("ESP_NameTag")
            if espNamesActive and head then
                if not existingTag then
                    local bg = Instance.new("BillboardGui")
                    bg.Name = "ESP_NameTag"
                    bg.Adornee = head
                    bg.Size = UDim2.new(0, 200, 0, 50)
                    bg.StudsOffset = Vector3.new(0, 2.5, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = head

                    local lbl = Instance.new("TextLabel")
                    lbl.Name = "InfoLabel"
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    lbl.TextStrokeTransparency = 0
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 13
                    lbl.Parent = bg
                end
            elseif existingTag then
                existingTag:Destroy()
            end
        end
    end
end

task.spawn(function()
    while true do
        if espNamesActive then
            local myRoot = getRoot()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    local tag = head and head:FindFirstChild("ESP_NameTag")
                    local lbl = tag and tag:FindFirstChild("InfoLabel")
                    if lbl and hum then
                        local dist = myRoot and math.floor((myRoot.Position - head.Position).Magnitude) or 0
                        lbl.Text = string.format("%s [%d HP] - %dm", p.DisplayName, math.floor(hum.Health), dist)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

